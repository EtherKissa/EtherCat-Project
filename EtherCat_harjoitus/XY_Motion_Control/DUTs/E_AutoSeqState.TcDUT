  <DUT Name="E_AutoSeqState" Id="{b8224aba-9e65-4fa2-9ea0-032b7e7e380b}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
{attribute 'strict'}
// Moves for the auto sequence
// Auto sekvenssin liikkeet
TYPE E_AutoSeqState :
(
	INIT,
    MOVE_X_SAFE_HOME,
	WAIT_X_SAFE_HOME,

    SET_Z_POSITION,
    WAIT_Z_DELAY,

    DECIDE_MOVE_ORDER,
	MOVE_Y,
    WAIT_Y,

