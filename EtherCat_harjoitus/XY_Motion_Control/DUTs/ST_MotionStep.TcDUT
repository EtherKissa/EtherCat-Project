  <DUT Name="ST_MotionStep" Id="{c558b0b0-c766-4ec8-962e-e3e446a5acc6}">
    <Declaration><![CDATA[TYPE ST_MotionStep :
STRUCT
	fTargetX		: LREAL; // Target position of X axis - AXIS1
	fTargetY		: LREAL; // Target position of Y axis - AXIS2
	nZaction		: INT; 	 // 1 = Lift, 2 = Lower, 0 = Do nothing
END_STRUCT
END_TYPE
]]></Declaration>
