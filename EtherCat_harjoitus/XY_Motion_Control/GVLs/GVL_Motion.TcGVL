<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <GVL Name="GVL_Motion" Id="{334edcf4-0254-40d8-9507-d80049dfbc5a}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
{attribute 'qualified_only'}
VAR_GLOBAL
	// Author RL
	// Hardware axis references
	Axis1               : AXIS_REF;	// X
	Axis2               : AXIS_REF;	// Y
	
	// Core system control
	bEnableAll          : BOOL := TRUE;	// Enables the drives
	bResetAll           : BOOL := FALSE;	// Resets possible servo errors
	bManualModeActive   : BOOL := FALSE; 	// Enables manual driving
	
	// Homing inputs and status check after homing
	bSensor_X           AT %I* : BOOL; 
	bSensor_Y           AT %I* : BOOL;
	bStartHoming        : BOOL := FALSE; 
	bXHomed             : BOOL := FALSE; 
	bYHomed             : BOOL := FALSE; 

	// Live axis position
	fCurrentX           : LREAL := 0.0;
	fCurrentY           : LREAL := 0.0;

	// "Z Axis" not really but kinda acts as a Z axis, this is a pneumatic lifter that is sitting on the Y axis
	bZlifter            AT %Q* : BOOL;      // FALSE = Raised, TRUE = Lowered)
	
	// Controls for manual driving, "Jogging"
	bJogForwardX        : BOOL := FALSE;    
	bJogForwardY        : BOOL := FALSE;    
	bJogBackwardsX      : BOOL := FALSE;    
	bJogBackwardsY      : BOOL := FALSE;
	fVelocityX          : LREAL := 5.0;
	fVelocityY          : LREAL := 10.0;
	
	// These calculate if moving is allowed, based on current position
	bX_Allow_Positive   : BOOL := FALSE;
	bX_Allow_Negative   : BOOL := FALSE;
	bY_Allow_Positive   : BOOL := FALSE;
	bY_Allow_Negative   : BOOL := FALSE;
	
	// States
	FORKS_IDLE          : INT := 0;
	FORKS_UP            : INT := 1;
	FORKS_DOWN          : INT := 2;
	
	nAutoState          : INT := 0; 
	bStartAutoseq     	: BOOL := FALSE;
	bAutoseqDone     	: BOOL := FALSE;
	bRetrievalMode    	: BOOL := FALSE;  // FALSE = Put away pallets, TRUE = Take away pallets

	
	nStepPointer        : INT := 1;
	nSubPhase           : INT := 0;
	nTotalSteps         : INT := 11;
	
	
	// This array system holds inside coordinates for the automatic sequence driving
	// NOTE: Actions of the pneumatic lift are reversed when bRetrievalMode = TRUE
	astPath : ARRAY[1..11] OF ST_MotionStep := [
		// "Shelf 1" cycle
		(fTargetX := 2.8000, fTargetY := 0.0,      nZAction := 1), // 1. Move to line and raise forks
		(fTargetX := 2.8000, fTargetY := -0.6247,  nZAction := 0), // 2. Moce Y to shelf 1 height
		(fTargetX := 9.3720, fTargetY := -0.6247,  nZAction := 2), // 3. Drive in and lower forks
		(fTargetX := 2.8000, fTargetY := -0.6247,  nZAction := 1), // 4. Retreat to safe line and raise forks
		
		// "Shelf 2" cycle
		(fTargetX := 2.8000, fTargetY := -9.5381,  nZAction := 0), // 5. Drop Y to shelf 2 height
		(fTargetX := 9.3720, fTargetY := -9.5381,  nZAction := 2), // 6. Drive in and lower forks
		(fTargetX := 2.8000, fTargetY := -9.5381,  nZAction := 1), // 7. Retreat to safe line and raise forks
		
		// "Shelf 3" cycle
		(fTargetX := 2.8000, fTargetY := -18.7514, nZAction := 0), // 8. Drop Y to shelf 3 height
		(fTargetX := 9.3720, fTargetY := -18.7514, nZAction := 2), // 9. Drive in and lower forks
		(fTargetX := 2.8000, fTargetY := -18.7514, nZAction := 1), // 10. Retreat to safe line and raise forks
		
		// Return to home after finishing
		(fTargetX := 0.0,    fTargetY := 0.0,      nZAction := 0)  // 14. Return X and Y to home coordinates
	];
	
END_VAR]]></Declaration>
  </GVL>
</TcPlcObject>