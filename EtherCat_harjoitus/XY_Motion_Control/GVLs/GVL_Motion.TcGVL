<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <GVL Name="GVL_Motion" Id="{334edcf4-0254-40d8-9507-d80049dfbc5a}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
VAR_GLOBAL
	Axis1           : AXIS_REF;
	Axis2           : AXIS_REF;
	
	bEnableAll      : BOOL := TRUE; 
	bResetAll       : BOOL := FALSE; 
	bSensor_X       : BOOL; 
	bSensor_Y       : BOOL; 
	
	bStartHoming    : BOOL := FALSE; 
	bXHomed         : BOOL := FALSE; 
	bYHomed         : BOOL := FALSE; 

	fCurrentX       : LREAL := 0.0;
	fCurrentY       : LREAL := 0.0;

	nAutoState      : INT := 0; 
	bStartAutoseq   : BOOL := FALSE;
	bAutoseqDone    : BOOL := FALSE;
	
	bZlifter        AT %Q* : BOOL;      // Forklift Lift Solenoid (TRUE = Forks Raised, FALSE = Forks Lowered)
	
	bManualModeActive : BOOL := FALSE;  
	
	bJogForwardX    : BOOL := FALSE;    
	bJogForwardY    : BOOL := FALSE;    
	bJogBackwardsX  : BOOL := FALSE;    
	bJogBackwardsY  : BOOL := FALSE;    
	
	fVelocityX      : LREAL;
	fVelocityY      : LREAL;
	
	bX_Allow_Positive   : BOOL := FALSE;
	bX_Allow_Negative   : BOOL := FALSE;
	bY_Allow_Positive   : BOOL := FALSE;
	bY_Allow_Negative   : BOOL := FALSE;

	// Automated Warehouse Tracking
	nStepPointer     : INT := 1;  // Current Target Shelf (1 to 4)
	nSubPhase        : INT := 0;  // Current Step in the Forklift Drop-off Sequence
	nTotalSteps      : INT := 4;  // Total number of shelves to process
	
	// The 4 Shelf Targets (Forks enter deep into X, at various Y shelf heights)
	astPath : ARRAY[1..4] OF ST_MotionStep := [
		(fTargetX := 9.3720,  fTargetY := -0.6247,  bMoveYFirst := TRUE,  bUseClearance := TRUE),  // Shelf 1
		(fTargetX := 9.3720,  fTargetY := -9.5381,  bMoveYFirst := TRUE,  bUseClearance := TRUE),  // Shelf 2
		(fTargetX := 9.3720,  fTargetY := -18.7514, bMoveYFirst := TRUE,  bUseClearance := TRUE),  // Shelf 3
		(fTargetX := 9.1100,  fTargetY := -34.00,   bMoveYFirst := TRUE,  bUseClearance := TRUE)   // Shelf 4
	];
END_VAR]]></Declaration>
  </GVL>
</TcPlcObject>