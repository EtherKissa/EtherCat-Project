<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <GVL Name="GVL_Motion" Id="{334edcf4-0254-40d8-9507-d80049dfbc5a}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
{attribute 'qualified_only'}
VAR_GLOBAL
	// Hardware axis references
	Axis1               : AXIS_REF;
	Axis2               : AXIS_REF;
	
	// Core system control flags
	bEnableAll          : BOOL := TRUE; 
	bResetAll           : BOOL := FALSE;
	bManualModeActive   : BOOL := FALSE; 
	
	// Homing inputs & status
	bSensor_X           AT %I* : BOOL; 
	bSensor_Y           AT %I* : BOOL;
	bStartHoming        : BOOL := FALSE; 
	bXHomed             : BOOL := FALSE; 
	bYHomed             : BOOL := FALSE; 

	// Live position registers
	fCurrentX           : LREAL := 0.0;
	fCurrentY           : LREAL := 0.0;

	// Hardware IO outputs
	bZlifter            AT %Q* : BOOL;      // Solenoid (FALSE = Raised, TRUE = Lowered)
	
	// UI Manual Jog signals & variables
	bJogForwardX        : BOOL := FALSE;    
	bJogForwardY        : BOOL := FALSE;    
	bJogBackwardsX      : BOOL := FALSE;    
	bJogBackwardsY      : BOOL := FALSE;
	fVelocityX          : LREAL := 5.0;
	fVelocityY          : LREAL := 10.0;
	
	// Dynamically calculated safety gates
	bX_Allow_Positive   : BOOL := FALSE;
	bX_Allow_Negative   : BOOL := FALSE;
	bY_Allow_Positive   : BOOL := FALSE;
	bY_Allow_Negative   : BOOL := FALSE;
	
	// Universal state constants
	FORKS_IDLE          : INT := 0;
	FORKS_UP            : INT := 1;
	FORKS_DOWN          : INT := 2;
	
	nAutoState          : INT := 0; 
	bStartAutoseq     	: BOOL := FALSE;
	bAutoseqDone     	: BOOL := FALSE;
	bRetrievalMode    	: BOOL := FALSE;  // FALSE = Put away pallets, TRUE = Take away palletsbStartAutoseq       : BOOL := FALSE;

	
	nStepPointer        : INT := 1;
	nSubPhase           : INT := 0;
	nTotalSteps         : INT := 11;
	
	// (Keep your astPath array declaration exactly as it is below this line...)
	
	// Change total steps to 13 to cover the 10 shelf movements + 3 return segments

	astPath : ARRAY[1..11] OF ST_MotionStep := [
		// --- SHELF 1 CYCLE ---
		(fTargetX := 2.8000, fTargetY := 0.0,      nZAction := 1), // 1. Move to aisle line & Raise forks
		(fTargetX := 2.8000, fTargetY := -0.6247,  nZAction := 0), // 2. Drop Y to shelf 1 height
		(fTargetX := 9.3720, fTargetY := -0.6247,  nZAction := 2), // 3. Drive deep into shelf & Lower forks
		(fTargetX := 2.8000, fTargetY := -0.6247,  nZAction := 1), // 4. Retreat to aisle line & Raise forks
		
		// --- SHELF 2 CYCLE ---
		(fTargetX := 2.8000, fTargetY := -9.5381,  nZAction := 0), // 5. Drop Y to shelf 2 height
		(fTargetX := 9.3720, fTargetY := -9.5381,  nZAction := 2), // 6. Drive deep into shelf & Lower forks
		(fTargetX := 2.8000, fTargetY := -9.5381,  nZAction := 1), // 7. Retreat to aisle line & Raise forks
		
		// --- SHELF 3 CYCLE ---
		(fTargetX := 2.8000, fTargetY := -18.7514, nZAction := 0), // 8. Drop Y to shelf 3 height
		(fTargetX := 9.3720, fTargetY := -18.7514, nZAction := 2), // 9. Drive deep into shelf & Lower forks
		(fTargetX := 2.8000, fTargetY := -18.7514, nZAction := 1), // 10. Retreat to aisle line & Raise forks
		
		// --- HOME RUN ---
		(fTargetX := 0.0,    fTargetY := 0.0,      nZAction := 0)  // 14. Return X and Y straight home
	];
	
END_VAR]]></Declaration>
  </GVL>
</TcPlcObject>