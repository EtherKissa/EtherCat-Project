<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <GVL Name="GVL_Motion" Id="{334edcf4-0254-40d8-9507-d80049dfbc5a}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
VAR_GLOBAL
	Axis1           : AXIS_REF;
	Axis2           : AXIS_REF;
	
	// Default to TRUE on boot
	bEnableAll      : BOOL := TRUE; 
	
	// Explicitly default everything else to FALSE/0
	bResetAll       : BOOL := FALSE; 
	bSensor_X       AT %I* : BOOL; // Physical hardware mapping
	bSensor_Y       AT %I* : BOOL; // Physical hardware mapping
	
	bStartHoming    : BOOL := FALSE; 
	bXHomed         : BOOL := FALSE; 
	bYHomed         : BOOL := FALSE; 

	fCurrentX       : LREAL := 0.0;
	fCurrentY       : LREAL := 0.0;

	nAutoState      : INT := 0; 
	bStartAutoseq   : BOOL := FALSE;
	bAutoseqDone    : BOOL := FALSE;
	
	bZlifter        AT %Q* : BOOL;      // Term 3 Channel 2 Pneumatic Solenoid Coil Output
	
	bManualModeActive : BOOL := FALSE;  // Master switch to change to manual mode
	
	bJogForwardX    : BOOL := FALSE;    // X axis manual drive forwards
	bJogForwardY    : BOOL := FALSE;    // Y axis manual drive forwards
	
	bJogBackwardsX  : BOOL := FALSE;    // X axis manual drive backwards
	bJogBackwardsY  : BOOL := FALSE;    // Y axis manual drive backwards
	
	fVelocityX      : LREAL;
	fVelocityY      : LREAL;
	
	// GLOBAL CROSS-POU SAFETY ENVELOPE TRACKING FLAGS
	bX_Allow_Positive   : BOOL := FALSE;
	bX_Allow_Negative   : BOOL := FALSE;
	bY_Allow_Positive   : BOOL := FALSE;
	bY_Allow_Negative   : BOOL := FALSE;

	// Automated Pointer Tracking Registers
	nStepPointer     : INT := 1;  // Current active step index
	nSubPhase        : INT := 0;  // Core data-driven sequencer phase tracking
	nTotalSteps      : INT := 6;  // Total number of steps in our sequence
	
	// =========================================================
	// MASTER MOTION PATH ARRAY (WITH LIFTER PARAMS INTERLOCKED)
	// =========================================================
	astPath : ARRAY[1..6] OF ST_MotionStep := [
		// Step 1: Location 1 (Rise up -> Travel -> Lower down)
		(fTargetX := 9.3720,  fTargetY := -0.6247,  bMoveYFirst := TRUE,  bUseClearance := FALSE, bLifterUpBeforeMove := TRUE,  bLifterDownAtTarget := TRUE),
		
		// Step 2: Location 2 (Rise up -> Retract X -> Plunge Y -> Drive X -> Lower down)
		(fTargetX := 9.3720,  fTargetY := -9.5381,  bMoveYFirst := TRUE,  bUseClearance := TRUE,  bLifterUpBeforeMove := TRUE,  bLifterDownAtTarget := TRUE),
		
		// Step 3: Location 3 (Rise up -> Retract X -> Plunge Y -> Drive X -> Lower down)
		(fTargetX := 9.3720,  fTargetY := -18.7514, bMoveYFirst := TRUE,  bUseClearance := TRUE,  bLifterUpBeforeMove := TRUE,  bLifterDownAtTarget := TRUE),
		
		// Step 4: Location 4 (Extended Deep Zone - Keep TargetX at your custom 9.1100 value)
		(fTargetX := 9.1100,  fTargetY := -34.00,   bMoveYFirst := TRUE,  bUseClearance := TRUE,  bLifterUpBeforeMove := TRUE,  bLifterDownAtTarget := TRUE),
		
		// Step 5: Retract X back to Home Base first (Keep lifter down/retracted out of the way)
		(fTargetX := 0.0,     fTargetY := -34.00,   bMoveYFirst := FALSE, bUseClearance := FALSE, bLifterUpBeforeMove := FALSE, bLifterDownAtTarget := FALSE),
		
		// Step 6: Bring Y back to Home Base last (Keep lifter safely down)
		(fTargetX := 0.0,     fTargetY := 0.0,      bMoveYFirst := TRUE,  bUseClearance := FALSE, bLifterUpBeforeMove := FALSE, bLifterDownAtTarget := FALSE)
	];
END_VAR]]></Declaration>
  </GVL>
</TcPlcObject>