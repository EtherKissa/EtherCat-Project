<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="PRG_Hardware" Id="{40a14d8f-cfdd-4224-908d-284dff0c3583}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM PRG_Hardware
VAR
	// Clean targeting registers used strictly by the active sequencer
	ExecuteMoveX       : BOOL; 
	ExecuteMoveY       : BOOL; 
	TargetX            : LREAL;
	TargetY            : LREAL;
	bSequenceResetPulse : BOOL;
	
	// Real physical motion instance calls: Power, Reset, and Calibration
	fbPower1           : MC_Power;
	fbPower2           : MC_Power;
	fbReset1           : MC_Reset;
	fbReset2           : MC_Reset;
	fbAutoMoveX        : MC_MoveAbsolute;
	fbAutoMoveY        : MC_MoveAbsolute;
	
	// Homing Sequences
	fbDriveToSensorX   : MC_MoveVelocity;
	fbDriveToSensorY   : MC_MoveVelocity;
	fbStopX            : MC_Stop;
	fbStopY            : MC_Stop;
	fbLockZeroX        : MC_SetPosition;
	fbLockZeroY        : MC_SetPosition;
	
	// Universal timers
	bFirstScanDone		: BOOL := FALSE;
	tPneumaticDelay		: TON;

END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[// 1. MC_Power Engine Hooks (Fed directly from PRG_Safety calculations)
fbPower1(
	Axis 				:= GVL_Motion.Axis1,
	Enable 				:= GVL_Motion.bEnableAll,
	Enable_Positive 	:= GVL_Motion.bEnableAll AND GVL_Motion.bX_Allow_Positive, 
	Enable_Negative 	:= GVL_Motion.bEnableAll AND GVL_Motion.bX_Allow_Negative);

fbPower2(
	Axis 				:= GVL_Motion.Axis2,
	Enable 				:= GVL_Motion.bEnableAll,
	Enable_Positive 	:= GVL_Motion.bEnableAll AND GVL_Motion.bY_Allow_Positive,
	Enable_Negative 	:= GVL_Motion.bEnableAll AND GVL_Motion.bY_Allow_Negative); 

fbReset1(
	Axis := GVL_Motion.Axis1,
	Execute := GVL_Motion.bResetAll);
	
fbReset2(
	Axis := GVL_Motion.Axis2,
	Execute := GVL_Motion.bResetAll);

// 2. AXIS X HOMING LOOP
fbDriveToSensorX(
	Axis      := GVL_Motion.Axis1,
	Execute   := GVL_Motion.bStartHoming AND NOT GVL_Motion.bSensor_X AND NOT GVL_Motion.bXHomed AND NOT fbStopX.Execute,
	Velocity  := 7.0,
	Direction := MC_Negative_Direction);

fbStopX(
	Axis    := GVL_Motion.Axis1,
	Execute := GVL_Motion.bStartHoming AND GVL_Motion.bSensor_X);

fbLockZeroX(
	Axis     := GVL_Motion.Axis1,
	Execute  := GVL_Motion.bStartHoming AND fbStopX.Done, 
	Position := 0.0,
	Mode     := FALSE);

// 3. AXIS Y HOMING LOOP
fbDriveToSensorY(
	Axis      := GVL_Motion.Axis2,
	Execute   := GVL_Motion.bStartHoming AND NOT GVL_Motion.bSensor_Y AND NOT GVL_Motion.bYHomed AND NOT fbStopY.Execute,
	Velocity  := 17.0,
	Direction := MC_Positive_Direction); 

fbStopY(
	Axis    := GVL_Motion.Axis2,
	Execute := GVL_Motion.bStartHoming AND GVL_Motion.bSensor_Y);

fbLockZeroY(
	Axis     := GVL_Motion.Axis2,
	Execute  := GVL_Motion.bStartHoming AND fbStopY.Done,
	Position := 0.0,
	Mode     := FALSE);

// 4. COORDINATION HANDSHAKE & PERMANENT LATCHING
IF fbLockZeroX.Done THEN GVL_Motion.bXHomed := TRUE;
END_IF

IF fbLockZeroY.Done THEN GVL_Motion.bYHomed := TRUE;
END_IF

IF GVL_Motion.bXHomed AND GVL_Motion.bYHomed THEN GVL_Motion.bStartHoming := FALSE; 
END_IF

IF NOT GVL_Motion.bStartHoming THEN
	fbStopX(Axis := GVL_Motion.Axis1, Execute := FALSE);
	fbStopY(Axis := GVL_Motion.Axis2, Execute := FALSE);
	fbLockZeroX(Axis := GVL_Motion.Axis1, Execute := FALSE);
	fbLockZeroY(Axis := GVL_Motion.Axis2, Execute := FALSE);
END_IF

// 5. 4-state automated sequence
IF GVL_Motion.bStartAutoseq AND GVL_Motion.bXHomed AND GVL_Motion.bYHomed AND NOT GVL_Motion.bManualModeActive THEN
	// Reset old commands
	bSequenceResetPulse	:= FALSE;

	IF GVL_Motion.nStepPointer <= GVL_Motion.nTotalSteps THEN
		
	CASE GVL_Motion.nSubPhase OF
			
			0: // STATE 0: PNEUMATIC DETERMINATION 
				tPneumaticDelay(IN := FALSE); 
				
				IF GVL_Motion.astPath[GVL_Motion.nStepPointer].nZAction = GVL_Motion.FORKS_UP THEN
					GVL_Motion.bZlifter := FALSE; // Lift the pneumatics
					GVL_Motion.nSubPhase := 5; 
				ELSIF GVL_Motion.astPath[GVL_Motion.nStepPointer].nZAction = GVL_Motion.FORKS_DOWN THEN
					GVL_Motion.bZlifter := TRUE;  // Lower the pneumatics
					GVL_Motion.nSubPhase := 5; 
				ELSE
					GVL_Motion.nSubPhase := 10; // No action needed, skip to travel
				END_IF
				
			5: // STATE 5: PNEUMATIC DWELL, delay to allow for setting
				tPneumaticDelay(IN := TRUE, PT := T#1500MS);
				IF tPneumaticDelay.Q THEN
					tPneumaticDelay(IN := FALSE);
					GVL_Motion.nSubPhase := 10; 
				END_IF
				
			10: // STATE 10: EXECUTE AXIS POSITIONING
				IF GVL_Motion.nStepPointer = GVL_Motion.nTotalSteps THEN
					ExecuteMoveX := FALSE;
					ExecuteMoveY := FALSE;
					GVL_Motion.nSubPhase := 80; // Head to Home sub-routines
					
				// Anti-collision interlocking
				ELSIF GVL_Motion.fCurrentX > 2.85 AND GVL_Motion.fCurrentY <> GVL_Motion.astPath[GVL_Motion.nStepPointer].fTargetY THEN
					TargetX := GVL_Motion.fCurrentX; 
					TargetY := GVL_Motion.astPath[GVL_Motion.nStepPointer].fTargetY;
					ExecuteMoveX := FALSE;
					ExecuteMoveY := TRUE;
				ELSE
					TargetX := GVL_Motion.astPath[GVL_Motion.nStepPointer].fTargetX;
					TargetY := GVL_Motion.astPath[GVL_Motion.nStepPointer].fTargetY;
					ExecuteMoveX := TRUE;
					ExecuteMoveY := TRUE; 
				END_IF
				
				// Wait for standard step completion
				IF GVL_Motion.nSubPhase = 10 AND 
				   (NOT ExecuteMoveX OR (fbAutoMoveX.Done AND NOT fbAutoMoveX.Busy)) AND
				   (NOT ExecuteMoveY OR (fbAutoMoveY.Done AND NOT fbAutoMoveY.Busy)) THEN
					
					ExecuteMoveX := FALSE;
					ExecuteMoveY := FALSE;
					GVL_Motion.nStepPointer := GVL_Motion.nStepPointer + 1; 
					GVL_Motion.nSubPhase := 0; 
				END_IF

			80: // STATE 80: SAFE HOME RETURN - RETRACT X FIRST
				// Get out of the shelf slot completely before changing Y heights
				TargetX := 2.8000;
				TargetY := GVL_Motion.fCurrentY;
				ExecuteMoveX := TRUE;
				ExecuteMoveY := FALSE;
				
				IF fbAutoMoveX.Done AND NOT fbAutoMoveX.Busy THEN
					ExecuteMoveX := FALSE;
					GVL_Motion.nSubPhase := 85;
				END_IF

			85: // STATE 85: SAFE HOME RETURN - CLEAR Y LEVEL TO FLOOR
				// Now that X is safely back at the aisle line, bring Y back up to ground level
				TargetX := GVL_Motion.fCurrentX;
				TargetY := 0.0;
				ExecuteMoveX := FALSE;
				ExecuteMoveY := TRUE;
				
				IF fbAutoMoveY.Done AND NOT fbAutoMoveY.Busy THEN
					ExecuteMoveY := FALSE;
					GVL_Motion.nSubPhase := 88;
				END_IF

			88: // STATE 88: SAFE HOME RETURN - DRIVE X TO PARKING SPOT
				// With Y at 0.0, the safety boundaries open wide, allowing X to park perfectly at 0.0
				TargetX := 0.0;
				TargetY := GVL_Motion.fCurrentY;
				ExecuteMoveX := TRUE;
				ExecuteMoveY := FALSE;
				
				IF fbAutoMoveX.Done AND NOT fbAutoMoveX.Busy THEN
					ExecuteMoveX := FALSE;
					GVL_Motion.bZlifter := FALSE; // Put forks in resting state
					
					// Entire run fully completed and parked
					GVL_Motion.bAutoseqDone := TRUE;
					GVL_Motion.bStartAutoseq := FALSE;
					GVL_Motion.nStepPointer := 1;
					GVL_Motion.nSubPhase := 0;
				END_IF
				
	END_CASE
		
	ELSE
		// Run complete, clear out variables cleanly
		GVL_Motion.bAutoseqDone := TRUE;
		GVL_Motion.bStartAutoseq := FALSE; 
		GVL_Motion.nStepPointer := 1;
		GVL_Motion.nSubPhase := 0;
	END_IF

ELSE
	ExecuteMoveX := FALSE;
	ExecuteMoveY := FALSE;
	tPneumaticDelay(IN := FALSE);
	
	// If bStartAutoseq is turned off, trigger bSequenceResetPulse high for EXACTLY one scan cycle,
	// then drop it back down. This cleans the FB registers completely without latching them shut.
	IF NOT GVL_Motion.bAutoseqDone THEN
		bSequenceResetPulse := TRUE;
	ELSE
		bSequenceResetPulse := FALSE;
	END_IF
END_IF

// 6. FINAL CENTRALIZED SYSTEM HOOK OUTPUTS
fbAutoMoveX(
	Axis     := GVL_Motion.Axis1,
	Execute  := ExecuteMoveX AND NOT GVL_Motion.bManualModeActive AND NOT bSequenceResetPulse, 
	Position := TargetX,
	Velocity := 5.0);
	
fbAutoMoveY(
	Axis     := GVL_Motion.Axis2,
	Execute  := ExecuteMoveY AND NOT GVL_Motion.bManualModeActive AND NOT bSequenceResetPulse, 
	Position := TargetY,
	Velocity := 10.0);]]></ST>
    </Implementation>
    <LineIds Name="PRG_Hardware">
