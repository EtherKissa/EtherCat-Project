<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="PRG_Manual_Drive" Id="{d7c8608d-950a-418f-b50b-6ce764434557}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM PRG_Manual_Drive
VAR
	// Motion blocks for manual driving
	fbJogX              : MC_Jog;
	fbJogY              : MC_Jog;
	
	// Safety guidelines
	bSafeJogForwardX    : BOOL;
	bSafeJogBackwardsX   : BOOL; // Fixed: Standardized naming convention
	
	bSafeJogForwardY    : BOOL;
	bSafeJogBackwardsY   : BOOL; // Fixed: Standardized naming convention
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =========================================================
// CALCULATE DIRECTIONAL SAFETY OVERRIDES
// =========================================================
IF GVL_Motion.bManualModeActive AND NOT GVL_Motion.bStartAutoseq THEN
	// Interlock live UI button presses with our real-time global safety envelopes
	bSafeJogForwardX  := GVL_Motion.bJogForwardX AND GVL_Motion.bX_Allow_Positive;
	bSafeJogBackwardsX := GVL_Motion.bJogBackwardsX AND GVL_Motion.bX_Allow_Negative; // Fixed capitalization typo
	
	bSafeJogForwardY  := GVL_Motion.bJogForwardY AND GVL_Motion.bY_Allow_Positive;
	bSafeJogBackwardsY := GVL_Motion.bJogBackwardsY AND GVL_Motion.bY_Allow_Negative;
ELSE
	// Instantly strip driving authorization if auto mode claims ownership or manual is disabled
	bSafeJogForwardX  := FALSE;
	bSafeJogBackwardsX := FALSE;
	bSafeJogForwardY  := FALSE;
	bSafeJogBackwardsY := FALSE;
END_IF


// =========================================================
// DEDICATED MANUAL JOG ENGINE CALLS
// =========================================================

// Axis 1 (X Axis) Manual Controller Hook
fbJogX(
	Axis           := GVL_Motion.Axis1,
	JogForward     := bSafeJogForwardX,
	JogBackwards    := bSafeJogBackwardsX, // FIXED: Changed to library standard 'JogBackward'
	Mode           := MC_JOGMODE_CONTINOUS,
	Velocity       := GVL_Motion.fVelocityX,
	Acceleration   := 50.0,
	Deceleration   := 50.0);
	
// Axis 2 (Y Axis) Manual Controller Hook
fbJogY(
	Axis           := GVL_Motion.Axis2,
	JogForward     := bSafeJogForwardY,
	JogBackwards    := bSafeJogBackwardsY, // FIXED: Changed to library standard 'JogBackward'
	Mode           := MC_JOGMODE_CONTINOUS,
	Velocity       := GVL_Motion.fVelocityY,
	Acceleration   := 50.0,
	Deceleration   := 50.0);]]></ST>
    </Implementation>
    <LineIds Name="PRG_Manual_Drive">
      <LineId Id="87" Count="40" />
      <LineId Id="20" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>